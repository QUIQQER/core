<?xml version="1.0" encoding="UTF-8"?>
<quiqqer xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://www.quiqqer.com/docs/schemas/2.x/group.xsd">
<group>

    <attributes>
        <attribute>description</attribute>
    </attributes>

    <window>
        <tab name="settings">
            <text>Einstellungen</text>
            <image>fa fa-gears</image>
            <template>SYS_DIR/template/groups/settings.html</template>
        </tab>

        <tab name="users">
            <text>Benutzer in der Gruppe</text>
            <image>fa fa-user</image>
            <onload>Group.showUsers</onload>
            <!--<onunload>_pcsg.lib.Groups.tabOnUnLoadGroup</onunload>-->
        </tab>
    </window>

</group>
</quiqqer>